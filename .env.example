# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- Required: the orchestrator brain ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Run mode ---
# 1 = no hardware (mock robot + mock perception) so the judge loop + UI run on a laptop.
CAREARM_MOCK=1

# --- Google Calendar (medication schedule) ---
# 0 = use the mock schedule in config/skills.yaml. 1 = use real Google Calendar
# (needs credentials.json in the repo root; see integrations/calendar.py).
USE_GOOGLE_CALENDAR=0
GOOGLE_CALENDAR_ID=primary

# --- Voice (optional) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
