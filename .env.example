# Copy this file to .env and fill in the values.
# .env is gitignored — never commit your real tokens.

# ── Agent backend ─────────────────────────────────────────────────────────────
# "ollama" (default, local, free) or "claude" (Anthropic API, requires key below)
AGENT_BACKEND=ollama

# ── Claude backend ─────────────────────────────────────────────────────────────
# Required when AGENT_BACKEND=claude. Get a key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the Claude model (default: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Ollama backend ─────────────────────────────────────────────────────────────
# Model to use. Recommended options:
#   qwen2.5:3b  — small, fast, clean replies  (ollama pull qwen2.5:3b)
#   qwen2.5:7b  — best local quality          (ollama pull qwen2.5:7b)
#   qwen3:4b    — default, has thinking mode  (ollama pull qwen3:4b)
OLLAMA_MODEL=qwen3:4b
# OLLAMA_URL=http://127.0.0.1:11434

# ── Server ─────────────────────────────────────────────────────────────────────
# 0 = real hardware. 1 = mock mode (no hardware, runs on laptop alone).
NURSEARM_MOCK=0
# Faster-Whisper model: base (~150MB), small, medium, large-v3
WHISPER_MODEL=base

# ── Camera source ──────────────────────────────────────────────────────────────
# realsense = Intel RealSense SDK (requires pyrealsense2 — not installed)
# webcam    = any V4L2 camera via OpenCV (use this)
NURSEARM_CAMERA_SOURCE=webcam
# Camera 1 — RealSense color via V4L2 (/dev/video8 confirmed)
NURSEARM_WEBCAM_INDEX=8
# Camera 2 — HBV HD CAMERA robot-mounted (/dev/video2 confirmed)
NURSEARM_CAMERA2_INDEX=2

# ── ACT policy ─────────────────────────────────────────────────────────────────
# Full path to lerobot-rollout when LeRobot uses a separate environment.
NURSEARM_LEROBOT_ROLLOUT=lerobot-rollout
# Path to the trained sort_pills checkpoint directory.
NURSEARM_SORT_PILLS_POLICY=
# Shared handover checkpoint. Use this only if one model reliably handles both colors.
NURSEARM_HANDOVER_PILLS_POLICY=
# Optional per-color overrides. These take precedence over the shared checkpoint.
NURSEARM_HANDOVER_GREEN_POLICY=
NURSEARM_HANDOVER_BLACK_POLICY=
# Must match the task labels and observation setup used during handover training.
NURSEARM_HANDOVER_TASK_TEMPLATE=Give the {color} pill to the hand
# Leave blank to use camera_arg and fps from config/robot.yaml.
NURSEARM_HANDOVER_CAMERA_ARG=
NURSEARM_HANDOVER_FPS=

# ── Telegram bot (OpenClaw Docker container) ───────────────────────────────────
# From @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
